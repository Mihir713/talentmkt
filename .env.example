# Copy to .env.local for local dev. Values come from `npx supabase status` after `npx supabase start`.
# Only the URL and the anon (publishable) key belong in the client. Never put the service-role key
# or ANTHROPIC_API_KEY in a VITE_* var — those live in Supabase Edge Function secrets only.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
